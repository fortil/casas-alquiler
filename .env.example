# --- Database (SQLite, local) ---
DATABASE_URL="file:./dev.db"

# --- Google Maps (geocoding + distance matrix) ---
# Server-side key (geocoding, distance matrix). Restrict by API in Cloud Console.
GOOGLE_MAPS_API_KEY=
# Browser key for the map widget (must allow the Maps JavaScript API + your localhost referrer).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Bright Data (scraping hard sites / fallback) ---
# Web Unlocker / Scraping Browser. Leave empty to disable Bright Data adapters/fallback.
BRIGHTDATA_API_KEY=
# Web Unlocker zone name (e.g. "web_unlocker1").
BRIGHTDATA_UNLOCKER_ZONE=
# Scraping Browser connect endpoint (wss://...). Optional; only needed for headless Tier C.
BRIGHTDATA_BROWSER_WS=
# SERP zone (distinct from the Unlocker zone above) used by "Descubrir sitios nuevos" in
# Configuración to search Google/Bing for candidate portals. Leave empty to disable that feature.
BRIGHTDATA_SERP_ZONE=

# --- Crawl defaults ---
# Comma-separated city slugs to crawl by default.
DEFAULT_CITIES="cali"
# Default reference point used when none supplied (lat,lng). Example: centro de Cali.
DEFAULT_REF_POINT="3.4516,-76.5320"
